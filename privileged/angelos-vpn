#!/usr/bin/python3
# angelOS: the VPN TUN helper. Runs as root through pkexec
# (org.angelos.vpn.helper: the active session, no password after the one-time install).
#
#   angelos-vpn up <socksPort> <apiPort> <serverHost> <dns> <appsCsv> <domainsCsv> <killSwitch>
#   angelos-vpn down
#   angelos-vpn status
#   angelos-vpn diag [host]                    diagnostics for the plugin's Logs tab
#   angelos-vpn guard                          internal: tear the tunnel down if its shell dies
#
# It takes only validated numbers, one host name and two comma-separated lists, builds the
# sing-box configuration itself and runs it: a TUN interface that sends everything to the
# local Xray SOCKS port, except the Xray process itself (its link to the server), private
# networks and the app / domain lists the user chose. UDP 443 (QUIC) is refused instead of
# tunneled: it cannot cross either transport, and an unanswered attempt makes browsers hang
# instead of falling back to TCP. No caller-supplied configuration is ever passed to
# sing-box.
import json
import os
import re
import signal
import socket
import stat
import subprocess
import sys
import time

# Fallback only: the plugin finds sing-box itself and passes the path in. Running a binary as
# root is the whole reason this file is careful, so an explicitly passed path is checked.
SB = "/opt/happ/bin/tun/sing-box"
IFACE = "angelvpn0"
RUNDIR = "/run/angelos-vpn"
CFG = os.path.join(RUNDIR, "sing-box.json")
PIDFILE = os.path.join(RUNDIR, "sing-box.pid")
LOGFILE = os.path.join(RUNDIR, "sing-box.log")

USAGE = ("usage: angelos-vpn up <socksPort> <apiPort> <host> <dns> <appsCsv> <domainsCsv> "
         "<killSwitch> [<singBoxPath>] [<hyCredentialsFile>] | down | status | diag [host] | guard")


def fail(msg, code=2):
    sys.stderr.write(msg + "\n")
    sys.exit(code)


def log_line(msg):
    """A note for the diagnostics the plugin reads; never fatal."""
    try:
        os.makedirs(RUNDIR, mode=0o700, exist_ok=True)
        with open(LOGFILE, "a") as f:
            f.write(msg + "\n")
    except OSError:
        pass


def valid_port(s):
    if not s or not re.fullmatch(r"[0-9]{1,5}", s):
        return None
    v = int(s)
    return v if 1 <= v <= 65535 else None


def valid_host(s):
    if not s or len(s) > 255:
        return None
    if not re.fullmatch(r"[A-Za-z0-9._:-]+", s):
        return None
    return s


def valid_dns(s):
    if not s or not re.fullmatch(r"[A-Za-z0-9._:-]+", s):
        return None
    return s


def valid_singbox(s):
    """A sing-box path that came from the caller. This process runs it as root, so the path
    must be absolute, a real executable file, and must not be writable by anyone else — a
    user-writable binary executed as root is privilege escalation, exactly what this helper
    exists to avoid. The parent directory is checked for the same reason: a writable directory
    lets the file be swapped after the check."""
    if not s:
        return SB
    if not s.startswith("/") or len(s) > 4096 or "\0" in s or "\n" in s:
        fail("bad sing-box path")
    try:
        st = os.stat(s)
    except OSError:
        fail("sing-box not found at " + s)
    if not stat.S_ISREG(st.st_mode):
        fail("sing-box is not a regular file: " + s)
    if not os.access(s, os.X_OK):
        fail("sing-box is not executable: " + s)
    if st.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
        fail("refusing to run a group/world-writable sing-box as root: " + s)
    # Not "must be owned by root": Happ ships its binaries owned by its build uid, and a
    # strict root-only rule would break a perfectly normal install. The real threat is the
    # *calling user* replacing the binary between the prompt and this exec, so the owner must
    # not be that user. PKEXEC_UID is set by polkit itself in the environment of a program it
    # starts, so it cannot be forged by the caller the way an argument could.
    caller = os.environ.get("PKEXEC_UID", "")
    caller_uid = int(caller) if caller.isdigit() else None
    if caller_uid is not None and st.st_uid == caller_uid:
        fail("refusing to run a sing-box owned by the calling user as root: " + s)
    d = os.path.dirname(s)
    try:
        ds = os.stat(d)
        if ds.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
            fail("refusing: the directory holding sing-box is writable by others: " + d)
        if caller_uid is not None and ds.st_uid == caller_uid:
            fail("refusing: the directory holding sing-box belongs to the calling user: " + d)
        # Rejecting only the *calling* user left a hole: a directory owned by some other
        # unprivileged account passed, and that account can rename the file out and put its
        # own in its place — the swap this whole function exists to prevent, one directory
        # further up. The owner has to be root, or the same account that owns the binary:
        # the latter keeps Happ's build-uid layout working, since there the two match.
        if ds.st_uid != 0 and ds.st_uid != st.st_uid:
            fail("refusing: the directory holding sing-box belongs to another user: " + d)
    except OSError:
        pass
    return s


def clean_names(csv, maxlen=200, maxn=128):
    out = []
    for p in (csv or "").split(","):
        p = p.strip()
        if not p or len(p) > maxlen or not re.fullmatch(r"[A-Za-z0-9._+@-]+", p):
            continue
        if p not in out:
            out.append(p)
        if len(out) >= maxn:
            break
    return out


def clean_domains(csv, maxn=256):
    out = []
    for d in (csv or "").split(","):
        d = d.strip().lower()
        if not d or len(d) > 253 or not re.fullmatch(r"\.?[a-z0-9*._-]+", d):
            continue
        if d not in out:
            out.append(d)
        if len(out) >= maxn:
            break
    return out


def resolve_v4(host):
    ips = set()
    try:
        for fam, _t, _p, _c, sa in socket.getaddrinfo(host, None):
            if fam == socket.AF_INET:
                ips.add(sa[0])
    except OSError:
        pass
    return sorted(ips)


def pick_iface():
    """A free interface name. Hard-coding one collides with another TUN client that got there
    first, and the symptom is baffling: sing-box fails to create the device and the plugin
    reports the tunnel as broken."""
    # IFACE already ends in a digit ("angelvpn0"), so the series is numbered after the stem
    # rather than after the whole name — otherwise the fallback reads "angelvpn01".
    stem = IFACE.rstrip("0123456789")
    for n in range(0, 16):
        name = "%s%d" % (stem, n)
        if not os.path.exists("/sys/class/net/" + name):
            return name
    return IFACE


def tun_address():
    """The tunnel address, avoiding a range the machine already routes.

    A fixed 172.30.0.0/30 collides with a corporate LAN and quietly breaks the route, so the
    first candidate that overlaps nothing already present wins."""
    import ipaddress
    try:
        routes = subprocess.run(["ip", "-o", "route", "show"],
                                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=5)
        existing = []
        for line in routes.stdout.decode("utf-8", "replace").splitlines():
            fields = line.split()
            if not fields:
                continue
            try:
                existing.append(ipaddress.ip_network(fields[0], strict=False))
            except ValueError:
                continue
    except Exception:  # noqa: BLE001
        existing = []
    for net, first in (("172.30.0.0/30", "172.30.0.1"), ("172.31.0.0/30", "172.31.0.1"),
                       ("10.203.0.0/30", "10.203.0.1")):
        cand = ipaddress.ip_network(net)
        if not any(cand.overlaps(e) for e in existing):
            return first + "/30"
    return "172.30.0.1/30"


def build_config(socks, api, host, dns, apps, domains, kill, hy=None):
    # Hysteria mode: sing-box is both the tunnel and the proxy, so no Xray runs at all and
    # nothing listens on the SOCKS/HTTP ports — every packet comes straight off the TUN into
    # the Hysteria2 outbound. `hy` is the credential dict the plugin wrote to a file we can
    # read as root; the password is deliberately not passed in argv, where any local process
    # could read it out of /proc.
    if hy is not None:
        rules = []
        for ip in resolve_v4(hy["server"]):
            rules.append({"ip_cidr": [ip + "/32"], "outbound": "direct"})
        rules.append({"action": "hijack-dns", "port": 53})
        rules.append({"ip_is_private": True, "outbound": "direct"})
        if domains:
            rules.append({"domain_suffix": domains, "outbound": "direct"})
        if apps:
            rules.append({"process_name": apps, "outbound": "direct"})
        # QUIC-in-QUIC is what this transport already is; browser QUIC to anywhere else just
        # rings the dead door, so answer it unreachable and let the browser fall back to TCP.
        rules.append({"port": 443, "network": "udp", "action": "reject"})
        tls = {"enabled": True, "insecure": bool(hy["insecure"])}
        if hy["sni"]:
            tls["server_name"] = hy["sni"]
        return {
            "log": {"level": "info", "timestamp": True, "output": LOGFILE},
            "dns": {
                "servers": [
                    {"type": "udp", "tag": "remote", "server": dns, "detour": "proxy"},
                    {"type": "local", "tag": "local"},
                ],
                # split-tunnel domains are looked up locally so their name never leaves via
                # the remote resolver before the route rule sends them direct.
                "rules": ([{"domain_suffix": domains, "server": "local"}] if domains else []),
                "final": "remote",
                "strategy": "ipv4_only",
                "independent_cache": True,
            },
            "inbounds": [{
                "type": "tun",
                "tag": "tun-in",
                "interface_name": pick_iface(),
                "address": [tun_address()],
                "mtu": 9000,
                "auto_route": True,
                "strict_route": bool(kill),
                "stack": "gvisor",
                "sniff": True,
            }],
            "outbounds": [
                {
                    "type": "hysteria2",
                    "tag": "proxy",
                    "server": hy["server"],
                    "server_port": hy["port"],
                    "password": hy["password"],
                    "tls": tls,
                    # Salamander is what the provider wraps the traffic in; without this
                    # block the server treats the packets as junk and never answers.
                    **({"obfs": {"type": "salamander",
                                 "password": hy["obfsPw"]}} if hy.get("obfsPw") else {}),
                },
                {"type": "direct", "tag": "direct", "domain_resolver": "local"},
            ],
            # The traffic counters come from Xray's API everywhere else, and there is no
            # Xray here — sing-box *is* the whole tunnel. Its clash API answers with
            # cumulative upload/download totals, which is the same number the panel shows
            # for every other server. Bound to loopback, like the Xray API inbound that
            # normalize() builds: nothing outside this machine can read a user's traffic.
            "experimental": {
                "clash_api": {"external_controller": "127.0.0.1:%d" % api}
            },
            "route": {
                "rules": rules,
                "final": "proxy",
                "auto_detect_interface": True,
                "default_domain_resolver": {"server": "local"},
            },
        }

    rules = [{"process_name": ["xray"], "outbound": "direct"}]
    for ip in resolve_v4(host):
        rules.append({"ip_cidr": [ip + "/32"], "outbound": "direct"})
    # sing-box 1.11+ hijacks DNS only when asked explicitly. Without this the queries the
    # TUN hands out (172.30.0.2:53) match ip_is_private further down and get sent into the
    # void, so nothing resolves and every HTTPS call dies.
    # NB: a rule without conditions matches *everything*, and hijack-dns is a final action
    # that feeds the connection to the DNS module — so the port filter is mandatory, or
    # ordinary TCP would be parsed as a DNS message and stall forever.
    rules.append({"action": "hijack-dns", "port": 53})
    rules.append({"ip_is_private": True, "outbound": "direct"})
    if domains:
        rules.append({"domain_suffix": domains, "outbound": "direct"})
    if apps:
        rules.append({"process_name": apps, "outbound": "direct"})
    # QUIC (UDP 443) cannot cross this tunnel on either transport: the provider breaks it
    # through XHTTP, and QUIC-in-QUIC through hysteria fails at the handshake. Left alone,
    # a browser keeps ringing the dead door and the page appears to hang while plain TCP
    # would have loaded it through the tunnel. Answer UDP 443 with port-unreachable AFTER
    # the direct exemptions above, so browsers fall back to TCP at once and apps marked
    # direct keep their QUIC on the physical interface.
    rules.append({"port": 443, "network": "udp", "action": "reject"})
    return {
        "log": {"level": "info", "timestamp": True, "output": LOGFILE},
        "dns": {
            "servers": [
                {"type": "udp", "tag": "remote", "server": dns, "detour": "proxy"},
                {"type": "local", "tag": "local"},
            ],
            # split-tunnel domains are looked up locally so their name never leaves via
            # the remote resolver before the route rule sends them direct.
            "rules": ([{"domain_suffix": domains, "server": "local"}] if domains else []),
            "final": "remote",
            "strategy": "ipv4_only",
            "independent_cache": True,
        },
        "inbounds": [{
            "type": "tun",
            "tag": "tun-in",
            "interface_name": pick_iface(),
            "address": [tun_address()],
            "mtu": 9000,
            "auto_route": True,
            "strict_route": bool(kill),
            # gvisor does TCP inside sing-box; "mixed" leans on the kernel redirect rules,
            # which silently swallowed every connection on this box.
            "stack": "gvisor",
            "sniff": True,
        }],
        "outbounds": [
            {"type": "socks", "tag": "proxy", "server": "127.0.0.1",
             "server_port": socks, "version": "5", "domain_resolver": "local"},
            {"type": "direct", "tag": "direct", "domain_resolver": "local"},
        ],
        "route": {
            "rules": rules,
            "final": "proxy",
            "auto_detect_interface": True,
            "default_domain_resolver": {"server": "local"},
        },
    }


def read_pid():
    try:
        with open(PIDFILE) as f:
            return int(f.read().strip())
    except (OSError, ValueError):
        return 0


def alive(pid):
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    return True


def stop_running():
    pid = read_pid()
    if alive(pid) and not is_sing_box(pid):
        # The pid was recycled by an unrelated process; killing it would hit a stranger.
        pid = 0
    if alive(pid):
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
        for _ in range(60):
            if not alive(pid):
                break
            time.sleep(0.1)
        # Re-check before escalating. Those six seconds are long enough for the kernel to hand
        # this pid to something else, and SIGKILL leaves no chance to notice: it would land on
        # a stranger while we believe we are still cleaning up our own tunnel.
        if alive(pid) and not is_sing_box(pid):
            log_line("angelos-vpn: pid %d is no longer sing-box; not escalating" % pid)
            pid = 0
        if alive(pid):
            try:
                os.kill(pid, signal.SIGKILL)
            except OSError:
                pass
            time.sleep(0.3)
    try:
        os.remove(PIDFILE)
    except OSError:
        pass
    # fallback: sing-box usually removes the interface itself on SIGTERM
    subprocess.run(["ip", "link", "delete", IFACE],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def is_sing_box(pid):
    """A pid alone proves nothing: if sing-box died and the pid was recycled, SIGTERM
    would land on whatever now owns it. Confirm the executable before signalling."""
    try:
        exe = os.readlink("/proc/%d/exe" % pid)
    except OSError:
        return False
    return os.path.basename(exe).startswith("sing-box")


def caller_uid():
    """The uid of the user who invoked us, or None when there is no pkexec in the picture.

    PKEXEC_UID is set by polkit in the environment of the process it starts, so unlike an
    argument it cannot be forged to point the lookup at another account. Without it we are
    being run directly (the tests, or a developer at a shell) and our own uid is the caller's.
    """
    uid = os.environ.get("PKEXEC_UID", "")
    if not uid:
        return os.getuid()
    if not uid.isdigit():
        fail("PKEXEC_UID is not a number: " + uid)
    return int(uid)


def read_hy_file(path):
    """The Hysteria credentials, from a file the plugin wrote rather than from argv.

    Anything in argv is world-readable through /proc while the command runs, so the password
    would belong to every process on the machine for as long as the tunnel was up. Here it
    arrives through a 0600 file that is deleted as soon as this returns — but the file is
    still user-written data read by a root process, so every field is treated as hostile and
    the values are re-checked rather than trusted.

    What stops a subscription from aiming us at, say, /etc/shadow is not the path's shape but
    its ownership: the file has to belong to the user who is asking. That is also why the
    directory is not constrained here. Pinning it to "<home>/.cache/angelos-vpn" looked
    stricter but broke every user who sets XDG_CACHE_HOME anywhere else — the plugin writes to
    $XDG_CACHE_HOME, so a hardcoded default is simply the wrong directory for them, and Hysteria
    then failed at the last step for everyone with a non-default cache. Ownership says the
    thing that actually matters and holds regardless of where the plugin keeps its cache.
    """
    if not path:
        return None
    if not path.startswith("/") or len(path) > 4096 or "\0" in path or "\n" in path:
        fail("bad credentials path")
    try:
        st = os.stat(path)
    except OSError:
        fail("credentials file not found: " + path)
    if not stat.S_ISREG(st.st_mode):
        fail("credentials file is not a regular file")
    uid = caller_uid()
    # os.stat follows symlinks, so this checks the file that actually gets opened: a symlink
    # the caller points at their own credentials is fine, one aimed at someone else's is not.
    if st.st_uid != uid:
        fail("credentials file does not belong to the calling user")
    if st.st_mode & (stat.S_IROTH | stat.S_IWOTH):
        fail("credentials file is readable by other users")
    if st.st_size > 8192:
        fail("credentials file is implausibly large")
    try:
        with open(path) as f:
            data = json.load(f)
    except (OSError, ValueError):
        fail("credentials file is not readable JSON")
    if not isinstance(data, dict):
        fail("credentials file is not an object")

    def field(key, maxlen):
        v = data.get(key, "")
        if not isinstance(v, str) or len(v) > maxlen or "\0" in v:
            fail("bad credentials field: " + key)
        return v

    server = valid_host(field("server", 255))
    if not server:
        fail("bad hysteria server")
    port = data.get("port", 443)
    if not isinstance(port, int) or isinstance(port, bool) or not 1 <= port <= 65535:
        fail("bad hysteria port")
    password = field("password", 1024)
    if not password:
        fail("hysteria password required for sing-box engine")
    sni = field("sni", 255)
    if sni and not re.fullmatch(r"[A-Za-z0-9._-]+", sni):
        fail("bad hysteria sni")
    insecure = data.get("insecure", False)
    if not isinstance(insecure, bool):
        fail("bad hysteria insecure flag")
    # Salamander obfuscation is a second secret the server may require; it is not optional
    # when the provider sent one, and passing it on when the server expects none is harmless.
    obfs_pw = field("obfsPw", 1024)

    # best effort: the secret has served its purpose once it is in the config
    try:
        os.remove(path)
    except OSError:
        pass
    return {"server": server, "port": port, "password": password,
            "sni": sni, "insecure": insecure, "obfsPw": obfs_pw}


def parse_up_args(argv):
    if len(argv) not in (7, 8, 9):
        fail(USAGE)
    socks = valid_port(argv[0])
    api = valid_port(argv[1])
    host = valid_host(argv[2])
    dns = valid_dns(argv[3] or "1.1.1.1")
    apps = clean_names(argv[4])
    domains = clean_domains(argv[5])
    kill = argv[6] in ("1", "true", "yes", "on")
    if socks is None or api is None:
        fail("bad port")
    if host is None:
        fail("bad host")
    if dns is None:
        fail("bad dns")
    # optional: where sing-box actually is, since the plugin looks it up itself
    sb = valid_singbox(argv[7] if len(argv) >= 8 else "")
    # optional: a file holding the Hysteria credentials. Its presence is what selects the
    # sing-box-only mode; every field is re-validated here because this runs as root and the
    # file is written by the user.
    hy = read_hy_file(argv[8] if len(argv) >= 9 else "")
    return socks, api, host, dns, apps, domains, kill, sb, hy


def cmd_up(argv):
    socks, api, host, dns, apps, domains, kill, sb, hy = parse_up_args(argv)
    cfg = build_config(socks, api, host, dns, apps, domains, kill, hy)
    stop_running()
    os.makedirs(RUNDIR, mode=0o700, exist_ok=True)
    # makedirs leaves an existing directory's mode alone, so an older or pre-created
    # /run/angelos-vpn would keep the config and log readable. This runs as root: fix it.
    try:
        os.chmod(RUNDIR, 0o700)
    except OSError:
        pass
    with open(CFG, "w") as f:
        json.dump(cfg, f, indent=2)
    log = open(LOGFILE, "ab", buffering=0)
    proc = subprocess.Popen([sb, "run", "-c", CFG],
                            stdin=subprocess.DEVNULL, stdout=log, stderr=log,
                            start_new_session=True)
    with open(PIDFILE, "w") as f:
        f.write(str(proc.pid))
    # make sure it did not die on a bad config right away
    time.sleep(1.3)
    if proc.poll() is not None:
        stop_running()
        fail("sing-box exited (code %d); see %s" % (proc.returncode, LOGFILE), 1)
    start_guard()
    print("up")
    return 0


def shell_alive():
    """Is any angelOS shell instance still running?

    The plugin cannot tell us its own pid reliably: Quickshell runs the plugin's Process
    children through a systemd scope, so their PPID is systemd, not the shell. Looking for
    the shell itself is therefore both simpler and more robust than being handed a pid — it
    does not care how the caller was started.

    Matching the `-c angelos` argument alone is NOT enough, and cost a live tunnel: once
    Quickshell is running it rewrites its own process title to just "quickshell" and the
    configuration argument is gone from /proc. The guard then saw no shell, concluded it had
    died, and tore the tunnel down while the desktop kept showing "connected". So the
    executable is matched too — and a bare quickshell counts as a shell, because the two
    failures are not equal: a false negative takes the network down on a running desktop,
    while a false positive leaves a tunnel up for a stray instance to be reaped by the
    normal disconnect.
    """
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        pid = int(entry)
        if pid == os.getpid():
            continue
        try:
            with open("/proc/%d/cmdline" % pid, "rb") as f:
                cmd = f.read().split(b"\0")
        except OSError:
            continue
        if not cmd or not cmd[0]:
            continue
        base = os.path.basename(cmd[0])
        # the guard binary runs as "angelos-vpn guard"; never mistake it for the shell
        if base.startswith(b"angelos-vpn"):
            continue
        # fast path: the wrapper still has its arguments, "qs -c angelos"
        if base in (b"qs", b"quickshell") and any(a == b"angelos" for a in cmd[1:]):
            return True
        # Quickshell has rewritten its title; fall back to the executable behind the pid
        try:
            exe = os.path.basename(os.readlink("/proc/%d/exe" % pid))
        except OSError:
            continue
        if exe in ("quickshell", "qs"):
            return True
    return False


def start_guard():
    """Keep a dead shell from holding the machine's network hostage.

    sing-box is started with start_new_session, so it is not in angelOS's process group and
    survives the shell. `qs kill` terminates the shell natively rather than exiting the
    application, so no QML Component.onDestruction runs and the shell cannot be relied on to
    clean up. This guard is its own root process: while a shell is running it does nothing,
    and the moment the last one is gone it takes the tunnel down itself.
    """
    if not shell_alive():
        # no shell to watch for: bringing the tunnel up now would already be orphaned
        log_line("angelos-vpn: no angelOS shell is running, not starting the tunnel watchdog")
    subprocess.Popen([sys.executable, os.path.abspath(__file__), "guard"],
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)


def cmd_guard(argv):
    """The watchdog. While an angelOS shell is running this does nothing; the moment the last
    one is gone it takes the tunnel down and exits, so it never outlives a tunnel.

    The shell is matched by process, not by a handed-in pid, because Quickshell starts the
    plugin's child processes inside a systemd scope — their PPID is systemd, so the caller
    cannot reliably report which process is the shell.
    """
    # one settle period: `up` may have been called just as a shell was restarting
    time.sleep(3)
    for _ in range(3600):
        pid = read_pid()
        if not alive(pid):
            return 0               # the tunnel is already down, nothing left to guard
        if shell_alive():
            time.sleep(2)
            continue
        log_line("angelos-vpn: no angelOS shell is left, taking the tunnel down")
        stop_running()
        return 0
    return 0


def cmd_down(argv):
    stop_running()
    print("down")
    return 0


def cmd_status(argv):
    pid = read_pid()
    print("up" if alive(pid) else "down")
    return 0


# ---- diagnostics (read-only, for the plugin's Logs tab) ----------------------
# Deliberately scoped to this tunnel. A blanket `ss -tulnp` or `nft list tables` would hand a
# local user a map of every other process and firewall rule on the machine through a
# passwordless root command; none of that helps diagnose the tunnel.

def _run(cmd):
    try:
        p = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=8)
        return p.stdout.decode("utf-8", "replace").rstrip()
    except Exception as e:  # noqa: BLE001
        return "! %s: %s" % (" ".join(cmd), e)


def _tail(path, n=150):
    try:
        with open(path, "rb") as f:
            data = f.read()
    except OSError as e:
        return "(cannot read %s: %s)" % (path, e)
    lines = data.decode("utf-8", "replace").splitlines()
    return "\n".join(lines[-n:])


def _diag_text(host=""):
    pid = read_pid()
    parts = ["==== sing-box: %s (pid %s) ====" % ("up" if alive(pid) else "down", pid or "-")]
    parts.append("==== sing-box log (tail 150) ====")
    parts.append(_tail(LOGFILE, 150) or "(empty)")
    parts.append("==== ip addr ====")
    parts.append(_run(["ip", "-br", "addr"]))
    parts.append("==== ip route (all tables) ====")
    parts.append(_run(["ip", "route", "show", "table", "all"]))
    parts.append("==== ip rule ====")
    parts.append(_run(["ip", "rule", "show"]))
    parts.append("==== route to 1.1.1.1 ====")
    parts.append(_run(["ip", "route", "get", "1.1.1.1"]))
    if host:
        parts.append("==== route to server (%s) ====" % host)
        parts.append(_run(["ip", "route", "get", host]))
    parts.append("==== resolv.conf ====")
    parts.append(_run(["cat", "/etc/resolv.conf"]))
    # only the local ports this plugin owns, not every socket on the machine
    ports = _our_ports()
    parts.append("==== our listening ports (socks=%s api=%s) ====" % (
        ports[0] if ports else "?", ports[1] if len(ports) > 1 else "?"))
    for port in ports:
        parts.append(_run(["ss", "-ltn", "sport", "=:%d" % port]))
    return "\n".join(parts)


def _our_ports():
    """The local ports this tunnel actually uses, read back from the running config.

    Looking for `"protocol": "socks"` among the inbounds, as this once did, never found
    anything: that is Xray's spelling, and the file read here is sing-box's, whose only inbound
    is the TUN device. Nothing listens on a port because of it — Xray does, and sing-box names
    Xray in an *outbound*, where the SOCKS port appears as its target. So the port is read from
    there instead.

    Returns [] when there is no such outbound, which is the Hysteria case: no core process is
    running at all and no local port is expected. The caller prints that plainly rather than
    two question marks, which read like a broken tunnel.
    """
    try:
        with open(CFG) as f:
            cfg = json.load(f)
    except (OSError, ValueError):
        return []
    socks = None
    for ob in cfg.get("outbounds") or []:
        if ob.get("type") == "socks" and ob.get("server") == "127.0.0.1":
            port = ob.get("server_port")
            if isinstance(port, int):
                socks = port
            break
    if socks is None:
        return []
    # the stats API sits a fixed 1000 above the socks port; that is how the plugin picks both
    return [socks, socks + 1000]


def cmd_diag(argv):
    # the host is only ever echoed into a label and handed to `ip route get` as an argv
    # entry (no shell), but validate it anyway so this root path stays strict
    host = valid_host(argv[0]) if argv else ""
    print(_diag_text(host or ""))
    return 0


def main(argv):
    if not argv:
        fail(USAGE)
    cmd, rest = argv[0], argv[1:]
    if cmd == "up":
        return cmd_up(rest)
    if cmd == "down":
        return cmd_down(rest)
    if cmd == "status":
        return cmd_status(rest)
    if cmd == "diag":
        return cmd_diag(rest)
    if cmd == "guard":
        return cmd_guard(rest)
    fail(USAGE)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
